# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Integration database safety guard
# Integration tests mutate their target database. Keep disabled unless an
# isolated test/staging database has been explicitly authorized.
INTEGRATION_TEST_DATABASE_AUTHORIZED="false"
INTEGRATION_TEST_DATABASE_PRODUCTION_AUTHORIZED="false"
INTEGRATION_TEST_DATABASE_EXPECTED_HOST=""
INTEGRATION_TEST_DATABASE_EXPECTED_NAME=""

# Manual migration safety guard
# This does not authorize production migrations for Phase 11C.
DATABASE_MIGRATION_AUTHORIZED="false"
DATABASE_MIGRATION_PRODUCTION_AUTHORIZED="false"
DATABASE_MIGRATION_EXPECTED_HOST=""
DATABASE_MIGRATION_EXPECTED_NAME=""

# Auth
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_URL="http://localhost:3000"
# Public browser auth base URL. Use the same origin as AUTH_URL unless deployment
# routing explicitly requires a different public origin.
NEXT_PUBLIC_AUTH_URL="http://localhost:3000"

# Development-only first admin bootstrap
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Google Drive artifact upload - service account
# Store the full service account credential JSON as a deployment secret.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Deprecated/unused OAuth placeholders from earlier planning.
# Phase 8B uses service-account auth only; do not repurpose these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_DRIVE_FOLDER_ID=""

# Durable export artifact storage - Cloudflare R2 / S3-compatible API
ARTIFACT_R2_ACCOUNT_ID=""
ARTIFACT_R2_ACCESS_KEY_ID=""
ARTIFACT_R2_SECRET_ACCESS_KEY=""
ARTIFACT_R2_BUCKET_NAME=""
